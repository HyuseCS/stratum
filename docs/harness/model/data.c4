model {
  extend stratum {
    advisor-dir = datafile '.stratum/advisor' {
      summary 'One review record per branch from the review point. st-advisor.sh writes it in the main checkout, git ignores it.'
      metadata {
        data '.stratum/advisor'
      }
    }
    advisor-json = datafile '.stratum/advisor.json' {
      summary 'The advisor mode: auto, codex, both or off. st-init writes it, st-advisor.sh reads it from the main checkout.'
      metadata {
        data '.stratum/advisor.json'
      }
    }
    approve = datafile '.stratum/approve' {
      summary 'A worker folder with the files it owns and the session id. st-worker.sh start writes it, st-approve.py reads it.'
      metadata {
        data '.stratum/approve'
      }
    }
    autonomous = datafile '.stratum/autonomous' {
      summary 'One empty entry per session in this folder of the main checkout, named with the session id. st-worker.sh makes and removes it, st-worker.sh, st-approve.py and the statusline read it.'
      metadata {
        data '.stratum/autonomous'
      }
    }
    commit-mode = datafile '.stratum/commit-mode' {
      summary 'A discontinued commit mode file. st-update removes it from each checkout.'
      metadata {
        data '.stratum/commit-mode'
      }
    }
    constitution-md = datafile '.stratum/constitution.md' {
      summary 'The project rules that override tool defaults. procedures/constitution.md writes it and every lane reads it.'
      metadata {
        data '.stratum/constitution.md'
      }
    }
    app-constitution-md = datafile '.stratum/APP-constitution.md' {
      summary 'The rules for how we work on one app in a multi-app repo. /st-close creates it or adds kept lessons to it.'
      metadata {
        data '.stratum/APP-constitution.md'
      }
    }
    decisions-md = datafile '.stratum/decisions.md' {
      summary 'Grill decisions when no feature is set. /st-grill writes it.'
      metadata {
        data '.stratum/decisions.md'
      }
    }
    research = datafile '.stratum/research' {
      summary 'Research files of /st-research when no feature folder is named. The st-research agent writes them.'
      metadata {
        data '.stratum/research'
      }
    }
    git-guard-json = datafile '.stratum/git-guard.json' {
      summary 'The git guard mode for commit and each risky git command. st-init and st-worker.sh write it, st-git-guard.py reads it.'
      metadata {
        data '.stratum/git-guard.json'
      }
    }
    handoff-md = datafile '.stratum/handoff.md' {
      summary 'The session handoff for the next session. /st-handoff writes it and the session start hook prints it.'
      metadata {
        data '.stratum/handoff.md'
      }
    }
    lessons-md = datafile '.stratum/lessons.md' {
      summary 'Proposed lessons with their target files. The st-close agent writes it and /st-close asks the user about each one.'
      metadata {
        data '.stratum/lessons.md'
      }
    }
    models-json = datafile '.stratum/models.json' {
      summary 'Model and effort overrides per agent. st-init and /st-model write it, st-models.py applies it when an agent starts.'
      metadata {
        data '.stratum/models.json'
      }
    }
    powerline-json = datafile '.stratum/powerline.json' {
      summary 'The project statusline theme, shape and colors. st-init, /st-theme and /st-shape write it, st-statusline.sh merges it.'
      metadata {
        data '.stratum/powerline.json'
      }
    }
    state-json = datafile '.stratum/state.json' {
      summary 'The current feature, phase, lane and risk level of this checkout. st-phase.py writes it, specify.md makes it empty and the st-quick agent sets phase done.'
      metadata {
        data '.stratum/state.json'
      }
    }
    templates = datafile '.stratum/templates' {
      summary 'Project copies of plugin templates that win over the plugin ones. /st-template copies them, resolve-template.sh finds them.'
      metadata {
        data '.stratum/templates'
      }
    }
    weather-json = datafile '.stratum/weather.json' {
      summary 'The Token Weather cache: compaction threshold and context growth per turn. token-weather.mjs writes it, the statusline reads it.'
      metadata {
        data '.stratum/weather.json'
      }
    }
    worker-setup-sh = datafile '.stratum/worker-setup.sh' {
      summary 'The user setup script for a new worker worktree. The user owns it and st-worker.sh start runs it.'
      metadata {
        data '.stratum/worker-setup.sh'
      }
    }
  }

  extend feature {
    spec-md = datafile 'specs/NNN-feature/spec.md' {
      summary 'The feature spec: stories, requirements and success criteria. procedures/specify.md writes it and procedures/clarify.md updates it.'
      metadata {
        data 'specs/NNN-feature/spec.md'
      }
    }
    plan-md = datafile 'specs/NNN-feature/plan.md' {
      summary 'The technical plan with its Validate section. The st-plan agent writes it with procedures/plan.md.'
      metadata {
        data 'specs/NNN-feature/plan.md'
      }
    }
    research-md = datafile 'specs/NNN-feature/research.md' {
      summary 'The decisions and reasons for the open questions of the plan. procedures/plan.md writes it in phase 0.'
      metadata {
        data 'specs/NNN-feature/research.md'
      }
    }
    data-model-md = datafile 'specs/NNN-feature/data-model.md' {
      summary 'The entities, fields and rules of the feature. procedures/plan.md writes it in phase 1.'
      metadata {
        data 'specs/NNN-feature/data-model.md'
      }
    }
    contracts = datafile 'specs/NNN-feature/contracts' {
      summary 'The interface contracts of the feature. procedures/plan.md writes them in phase 1.'
      metadata {
        data 'specs/NNN-feature/contracts'
      }
    }
    quickstart-md = datafile 'specs/NNN-feature/quickstart.md' {
      summary 'The test steps for each story. procedures/plan.md writes it and /st-build runs its steps at each story end.'
      metadata {
        data 'specs/NNN-feature/quickstart.md'
      }
    }
    tasks-md = datafile 'specs/NNN-feature/tasks.md' {
      summary 'The ordered tasks with their tests and owned files. procedures/tasks.md writes it and /st-build ticks a task when its test is green.'
      metadata {
        data 'specs/NNN-feature/tasks.md'
      }
    }
    checklists = datafile 'specs/NNN-feature/checklists' {
      summary 'The requirement quality checklists. procedures/specify.md writes requirements.md and procedures/checklist.md writes the others.'
      metadata {
        data 'specs/NNN-feature/checklists'
      }
    }
    changes = datafile 'specs/NNN-feature/changes' {
      summary 'The Fast-lane change plans, one NNN-name.md each. The st-fast agent writes them.'
      metadata {
        data 'specs/NNN-feature/changes'
      }
    }
    decisions-md = datafile 'specs/NNN-feature/decisions.md' {
      summary 'The grill decisions of the feature, with the option picked and the one rejected. /st-grill writes it.'
      metadata {
        data 'specs/NNN-feature/decisions.md'
      }
    }
    advisor-md = datafile 'specs/NNN-feature/advisor.md' {
      summary 'One record per advisor run: point, time, input hash, verdict and findings. st-advisor.sh appends it.'
      metadata {
        data 'specs/NNN-feature/advisor.md'
      }
    }
    gaps-md = datafile 'specs/NNN-feature/gaps.md' {
      summary 'A side note of gaps seen in a feature, linked from no page. No harness file reads or writes it.'
      metadata {
        data 'specs/NNN-feature/gaps.md'
      }
    }
  }

  extend project {
    design-md = datafile 'DESIGN.md' {
      summary 'The project design file, with .impeccable/design.json beside it. The Design lane writes it and screen tasks build from it.'
      metadata {
        data 'DESIGN.md'
      }
    }
    agents-md = datafile 'AGENTS.md' {
      summary 'Project instructions for any agent: read the constitution, specs live in specs. st-init creates it when it is missing.'
      metadata {
        data 'AGENTS.md'
      }
    }
    claude-md = datafile 'CLAUDE.md' {
      summary 'Two import lines that load AGENTS.md and the constitution in Claude Code. st-init creates it when it is missing.'
      metadata {
        data 'CLAUDE.md'
      }
    }
    graphify-out-graph-report-md = datafile 'graphify-out/GRAPH_REPORT.md' {
      summary 'The code graph report that agents read first to find files. graphify writes it.'
      metadata {
        data 'graphify-out/GRAPH_REPORT.md'
      }
    }
    graphify-out = datafile 'graphify-out' {
      summary 'The graphify code graph folder, rebuilt by the graphify post-commit hook. It stays out of git.'
      metadata {
        data 'graphify-out'
      }
    }
    claude-settings-json = datafile '.claude/settings.json' {
      summary 'The committed project Claude Code settings: plugins turned off and tools allowed. st-init merges its keys and st-update checks them.'
      metadata {
        data '.claude/settings.json'
      }
    }
    claude-settings-local-json = datafile '.claude/settings.local.json' {
      summary 'The machine-only project settings with the statusline command and plugin path. st-init writes it and it is not committed.'
      metadata {
        data '.claude/settings.local.json'
      }
    }
    impeccable = datafile '.impeccable' {
      summary 'The impeccable folder beside DESIGN.md: design.json, local config and critiques. The Design lane writes it.'
      metadata {
        data '.impeccable'
      }
    }
    gitignore = datafile '.gitignore' {
      summary 'The project git ignore list. st-init, /st-handoff and /st-close add the local .stratum files to it.'
      metadata {
        data '.gitignore'
      }
    }
    specs = datafile 'specs' {
      summary 'The folder that holds one specs/NNN-feature folder per feature. st-init creates it empty.'
      metadata {
        data 'specs'
      }
    }
    apps-app-ordinance-md = datafile 'apps/APP/ORDINANCE.md' {
      summary 'The rules for one app in a multi-app repo. The st-plan and st-inspect agents read it, /st-close adds kept lessons to it.'
      metadata {
        data 'apps/APP/ORDINANCE.md'
      }
    }
    apps-app-claude-md = datafile 'apps/APP/CLAUDE.md' {
      summary 'The one-line file that loads ORDINANCE.md in that app. /st-close creates it when it is missing.'
      metadata {
        data 'apps/APP/CLAUDE.md'
      }
    }
    package-json = datafile 'package.json' {
      summary 'The project package file. /st-design reads the framework and the dev script port from it.'
      metadata {
        data 'package.json'
      }
    }
    product-md = datafile 'PRODUCT.md' {
      summary 'The product context for design work. /st-impeccable writes it with init and reads it before each design task.'
      metadata {
        data 'PRODUCT.md'
      }
    }
    design-system = datafile 'design-system' {
      summary 'The persisted design system: MASTER.md and page overrides. /st-ui-ux writes and reads it.'
      metadata {
        data 'design-system'
      }
    }
    hallmark = datafile '.hallmark' {
      summary 'The hallmark folder: brand spec, preflight cache and build log. /st-hallmark reads and writes it.'
      metadata {
        data '.hallmark'
      }
    }
    design = datafile 'design' {
      summary 'The FigCraft design files and their read exports. st-figcraft.sh start creates it and FigCraft may write only here.'
      metadata {
        data 'design'
      }
    }
    git-stratum-name-lock = datafile '.git/stratum-NAME.lock' {
      summary 'The test lock folder with the owner pid and start time. st-lock.sh makes it in the git common dir and removes it.'
      metadata {
        data '.git/stratum-NAME.lock'
      }
    }
    claude-local-md = datafile 'CLAUDE.local.md' {
      summary 'The machine-only Claude Code instructions. st-update.sh reads it for the constitution pointer.'
      metadata {
        data 'CLAUDE.local.md'
      }
    }
    brief-md = datafile 'brief.md' {
      summary 'The worker brief in a worker worktree: task, facts, roster and team rules. st-worker.sh writes it.'
      metadata {
        data 'brief.md'
      }
    }
    result-md = datafile 'result.md' {
      summary 'The worker result in a worker worktree. The worker writes it and st-worker.sh reads it and renames it at followup.'
      metadata {
        data 'result.md'
      }
    }
  }

  extend plugin {
    templates-checklist-md = pluginfile 'templates/checklist.md' {
      summary 'The plugin checklist template. resolve-template.sh returns it when the project has no own copy.'
      metadata {
        path 'templates/checklist.md'
      }
    }
    templates-constitution-md = pluginfile 'templates/constitution.md' {
      summary 'The plugin constitution template. resolve-template.sh returns it when the project has no own copy.'
      metadata {
        path 'templates/constitution.md'
      }
    }
    templates-models-json = pluginfile 'templates/models.json' {
      summary 'The default agent model and effort file. st-init and /st-model copy it to .stratum/models.json.'
      metadata {
        path 'templates/models.json'
      }
    }
    templates-plan-md = pluginfile 'templates/plan.md' {
      summary 'The plugin plan template. resolve-template.sh returns it when the project has no own copy.'
      metadata {
        path 'templates/plan.md'
      }
    }
    templates-pr-md = pluginfile 'templates/pr.md' {
      summary 'The plugin pull request body template. /st-pr uses it when the project has no own copy.'
      metadata {
        path 'templates/pr.md'
      }
    }
    templates-spec-md = pluginfile 'templates/spec.md' {
      summary 'The plugin spec template. resolve-template.sh returns it when the project has no own copy.'
      metadata {
        path 'templates/spec.md'
      }
    }
    templates-tasks-md = pluginfile 'templates/tasks.md' {
      summary 'The plugin tasks template. resolve-template.sh returns it when the project has no own copy.'
      metadata {
        path 'templates/tasks.md'
      }
    }
    claude-plugin-plugin-json = pluginfile '.claude-plugin/plugin.json' {
      summary 'The plugin manifest: name, version, hook file, the figcraft MCP server and the git guard options.'
      metadata {
        path '.claude-plugin/plugin.json'
      }
    }
    vendor-lock = pluginfile 'vendor.lock' {
      summary 'The pinned upstream repo and commit of each vendored skill, with the last sync date. /st-sync updates it.'
      metadata {
        path 'vendor.lock'
      }
    }
    sr-opus-5-md = pluginfile 'sr-opus-5.md' {
      summary 'The report style rules. Each Stratum agent reads it first and follows it in its report.'
      metadata {
        path 'sr-opus-5.md'
      }
    }
    third-party-notices-md = pluginfile 'THIRD_PARTY_NOTICES.md' {
      summary 'The license notice of each forked or vendored upstream and the Stratum files it maps to.'
      metadata {
        path 'THIRD_PARTY_NOTICES.md'
      }
    }
    workflows-pr-js = pluginfile 'workflows/pr.js' {
      summary 'The pull request workflow script. /st-pr runs it as the Workflow stratum:pr.'
      metadata {
        path 'workflows/pr.js'
      }
    }
    templates = pluginfile 'templates' {
      summary 'The plugin template folder. /st-template lists it and copies one template into .stratum/templates.'
      metadata {
        path 'templates'
      }
    }
  }

  extend outside {
    local-state-stratum-codex-home = datafile '~/.local/state/stratum/codex-home' {
      summary 'The Stratum Codex home: a link to the user Codex login and a config.toml that marks each project untrusted. st-advisor.sh codex-home makes it.'
      metadata {
        data '~/.local/state/stratum/codex-home'
      }
    }
    claude-settings-json = datafile '~/.claude/settings.json' {
      summary 'The user Claude Code settings: enabled plugins and plugin options. Stratum reads it and never changes it.'
      metadata {
        data '~/.claude/settings.json'
      }
    }
    claude-ponytail-active = datafile '~/.claude/.ponytail-active' {
      summary 'The live ponytail mode as a shared flag. ponytail-runtime.js writes it and the ponytail statusline reads it.'
      metadata {
        data '~/.claude/.ponytail-active'
      }
    }
    claude-ponytail-modes = datafile '~/.claude/ponytail-modes' {
      summary 'The live ponytail mode for each project. ponytail-runtime.js reads and writes it.'
      metadata {
        data '~/.claude/ponytail-modes'
      }
    }
    config-ponytail-config-json = datafile '~/.config/ponytail/config.json' {
      summary 'The user ponytail settings: default mode, quiet startup and hide status. ponytail-config.js reads and writes it.'
      metadata {
        data '~/.config/ponytail/config.json'
      }
    }
    codex-auth-json = datafile '~/.codex/auth.json' {
      summary 'The user Codex login. st-advisor.sh links it into the Stratum Codex home.'
      metadata {
        data '~/.codex/auth.json'
      }
    }
    xdg-runtime-dir-st-figcraft-port = datafile '$XDG_RUNTIME_DIR/st-figcraft-PORT' {
      summary 'The record of a running FigCraft: pid, project folder and start log. st-figcraft.sh writes and reads it.'
      metadata {
        data '$XDG_RUNTIME_DIR/st-figcraft-PORT'
      }
    }
    claude-plugins-installed-plugins-json = datafile '~/.claude/plugins/installed_plugins.json' {
      summary 'The Claude Code record of installed plugins. st-update.sh reads the Stratum install records from it.'
      metadata {
        data '~/.claude/plugins/installed_plugins.json'
      }
    }
    claude-plugins-known-marketplaces-json = datafile '~/.claude/plugins/known_marketplaces.json' {
      summary 'The Claude Code list of plugin marketplaces. st-update.sh reads the Stratum marketplace location from it.'
      metadata {
        data '~/.claude/plugins/known_marketplaces.json'
      }
    }
    claude-projects-project-memory = datafile '~/.claude/projects/PROJECT/memory' {
      summary 'The Claude memory folder of a checkout. st-worktree.sh links the worktree memory to the main checkout one.'
      metadata {
        data '~/.claude/projects/PROJECT/memory'
      }
    }
  }

  user -[writes]-> stratum.worker-setup-sh 'setup commands for a new worker worktree'
  user -[writes]-> stratum.advisor-json 'advisor mode'
  user -[writes]-> stratum.git-guard-json 'git guard modes'
  user -[writes]-> stratum.models-json 'agent model and effort'
  user -[writes]-> stratum.powerline-json 'custom colors'
  claude -[reads]-> plugin.claude-plugin-plugin-json 'hook file, figcraft MCP server and git guard options'
  claude -[reads]-> project.claude-md 'AGENTS.md and constitution imports'
  claude -[reads]-> project.agents-md 'project instructions'
  claude -[reads]-> stratum.constitution-md 'project rules'
  claude -[reads]-> project.claude-settings-json 'plugins turned off and allowed tools'
  claude -[reads]-> project.claude-settings-local-json 'statusline command'
  claude -[reads]-> outside.claude-settings-json 'enabled plugins and plugin options'
  codex -[reads]-> outside.local-state-stratum-codex-home 'Codex login link and project trust level'
  plugin.claude-plugin-plugin-json -[runs]-> scripts.st-figcraft-sh 'mcp server'
}
