views {
  dynamic view design {
    title 'Design lane'
    user -> skills.st-design '(1) task in plain words'
    skills.st-design -> scripts.st-design-check-sh '(2) tool check, --custom in the custom mode'
    skills.st-design -> project.design-md '(3) design file check: DESIGN.md with .impeccable/design.json'
    skills.st-design -> user '(4) mode line: new look, autonomous or custom'
    skills.st-design -> user '(5) new look: grill questions, each with a recommended answer' { navigateTo design-new-look }
    user -> skills.st-design '(6) gate: yes, commit the reference screen'
    skills.st-design -> user '(7) autonomous, no design file: grill from the look in the code, once per project' { navigateTo design-autonomous }
    user -> skills.st-design '(8) OK to commit'
    skills.st-design -> user '(9) custom: grill questions, theme deal only for a new look' { navigateTo design-custom }
    user -> skills.st-design '(10) gate: yes, commit the screen and the saved design'
  }
  dynamic view design-new-look {
    title 'Design lane: New look'
    skills.st-design -> user '(1) new look: grill questions, each with a recommended answer'
    user -> skills.st-design '(2) audience, use, tone, material and the other answers'
    skills.st-design -> skills.st-hallmark '(3) deal: genre and brief'
    skills.st-design -> user '(4) 3 themes with pictures and a recommended one'
    user -> skills.st-design '(5) picked theme'
    skills.st-design -> skills.st-hallmark '(6) scaffold: picked theme'
    skills.st-design -> skills.st-impeccable '(7) document in scan mode with the grill answers'
    skills.st-impeccable -> user '(8) DESIGN.md to confirm'
    user -> skills.st-impeccable '(9) confirm the design file'
    skills.st-design -> agents.st-design '(10) task, mode, answers, assumed answers, dev server URL'
    agents.st-design -> project.design-md '(11) DESIGN.md as the locked system'
    agents.st-design -> skills.st-hallmark '(12) build flow and sloplint check'
    agents.st-design -> skills.st-design '(13) report: files, screenshots, picks, lint and render results'
    skills.st-design -> project.impeccable '(14) ignore rules from the engine ignore line'
    skills.st-design -> skills.st-impeccable '(15) audit dimensions 1 and 2, then critique in full'
    skills.st-impeccable -> skills.st-design '(16) audit and critique findings'
    skills.st-design -> agents.st-design '(17) fix round: findings that block a pass, at most 2 rounds'
    skills.st-design -> project.impeccable '(18) added ignore rules removed'
    skills.st-design -> user '(19) screenshots, picks and report'
    user -> skills.st-design '(20) gate: yes, commit the reference screen'
    skills.st-design -> agents.st-git '(21) agent paths, DESIGN.md, .impeccable/design.json, tokens.css, base.css'
    agents.st-git -> git '(22) commit'
  }
  dynamic view design-autonomous {
    title 'Design lane: Autonomous'
    skills.st-design -> user '(1) autonomous, no design file: grill from the look in the code, once per project'
    skills.st-design -> skills.st-impeccable '(2) document in scan mode with the grill answers'
    skills.st-design -> project.design-md '(3) page job, visitor and main action'
    skills.st-design -> user '(4) missing job, visitor or main action, asked once'
    skills.st-design -> agents.st-design '(5) task, mode, job, visitor, main action, assumed answers'
    agents.st-design -> skills.st-design '(6) report: files, screenshots, lint and render results'
    skills.st-design -> skills.st-impeccable '(7) audit and critique, at most 2 fix rounds'
    skills.st-design -> user '(8) report with no picks'
    user -> skills.st-design '(9) OK to commit'
    skills.st-design -> agents.st-git '(10) agent paths and changed design files'
    agents.st-git -> git '(11) commit'
  }
  dynamic view design-custom {
    title 'Design lane: Custom'
    skills.st-design -> user '(1) custom: grill questions, theme deal only for a new look'
    user -> skills.st-design '(2) grill answers'
    skills.st-design -> scripts.st-figcraft-sh '(3) start: project root'
    skills.st-design -> agents.st-design '(4) step draw: screen name, answers'
    agents.st-design -> project.design '(5) drawn screen saved as a FigCraft file'
    agents.st-design -> skills.st-design '(6) document id'
    skills.st-design -> user '(7) design is open in the design tool, say when it looks good'
    user -> skills.st-design '(8) change request or looks good'
    skills.st-design -> agents.st-design '(9) step change: request and document id'
    skills.st-design -> agents.st-design '(10) step save: document id'
    agents.st-design -> project.design '(11) saved design and its read export'
    agents.st-design -> skills.st-design '(12) saved design path and token files written'
    skills.st-design -> skills.st-impeccable '(13) document in scan mode, file shown at the gate'
    skills.st-design -> agents.st-design '(14) step build: screen name'
    agents.st-design -> project.design '(15) saved design layout, picture and variables'
    agents.st-design -> skills.st-design '(16) report: files, screenshots, lint and render results'
    skills.st-design -> skills.st-impeccable '(17) audit and critique, at most 2 fix rounds'
    skills.st-design -> user '(18) screenshots, theme pick, report and DESIGN.md'
    user -> skills.st-design '(19) gate: yes, commit the screen and the saved design'
    skills.st-design -> agents.st-git '(20) agent paths, DESIGN.md and the saved design'
    agents.st-git -> git '(21) commit'
  }
}
