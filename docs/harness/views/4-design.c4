views {
  dynamic view design {
    title 'Design lane'
    user -> skills.st-design '(1) task in plain words'
    skills.st-design -> scripts.st-design-check-sh '(2) tool check, --custom in the custom mode'
    skills.st-design -> project.design-md '(3) design file check: DESIGN.md with .impeccable/design.json'
    skills.st-design -> user '(4) mode line: new look, autonomous or custom'
    skills.st-design -> user '(5) new look: grill questions, each with a recommended answer'
    user -> skills.st-design '(6) audience, use, tone, material and the other answers'
    skills.st-design -> skills.st-hallmark '(7) deal: genre and brief'
    skills.st-design -> user '(8) 3 themes with pictures and a recommended one'
    user -> skills.st-design '(9) picked theme'
    skills.st-design -> skills.st-hallmark '(10) scaffold: picked theme'
    skills.st-design -> skills.st-impeccable '(11) document in scan mode with the grill answers'
    skills.st-impeccable -> user '(12) DESIGN.md to confirm'
    user -> skills.st-impeccable '(13) confirm the design file'
    skills.st-design -> agents.st-design '(14) task, mode, answers, assumed answers, dev server URL'
    agents.st-design -> project.design-md '(15) DESIGN.md as the locked system'
    agents.st-design -> skills.st-hallmark '(16) build flow and sloplint check'
    agents.st-design -> skills.st-design '(17) report: files, screenshots, picks, lint and render results'
    skills.st-design -> project.impeccable '(18) ignore rules from the engine ignore line'
    skills.st-design -> skills.st-impeccable '(19) audit dimensions 1 and 2, then critique in full'
    skills.st-impeccable -> skills.st-design '(20) audit and critique findings'
    skills.st-design -> agents.st-design '(21) fix round: findings that block a pass, at most 2 rounds'
    skills.st-design -> project.impeccable '(22) added ignore rules removed'
    skills.st-design -> user '(23) screenshots, picks and report'
    user -> skills.st-design '(24) gate: yes, commit the reference screen'
    skills.st-design -> agents.st-git '(25) agent paths, DESIGN.md, .impeccable/design.json, tokens.css, base.css'
    agents.st-git -> git '(26) commit'
    skills.st-design -> user '(27) autonomous, no design file: grill from the look in the code, once per project'
    skills.st-design -> skills.st-impeccable '(28) document in scan mode with the grill answers'
    skills.st-design -> project.design-md '(29) page job, visitor and main action'
    skills.st-design -> user '(30) missing job, visitor or main action, asked once'
    skills.st-design -> agents.st-design '(31) task, mode, job, visitor, main action, assumed answers'
    agents.st-design -> skills.st-design '(32) report: files, screenshots, lint and render results'
    skills.st-design -> skills.st-impeccable '(33) audit and critique, at most 2 fix rounds'
    skills.st-design -> user '(34) report with no picks'
    user -> skills.st-design '(35) OK to commit'
    skills.st-design -> agents.st-git '(36) agent paths and changed design files'
    agents.st-git -> git '(37) commit'
    skills.st-design -> user '(38) custom: grill questions, theme deal only for a new look'
    user -> skills.st-design '(39) grill answers'
    skills.st-design -> scripts.st-figcraft-sh '(40) start: project root'
    skills.st-design -> agents.st-design '(41) step draw: screen name, answers'
    agents.st-design -> project.design '(42) drawn screen saved as a FigCraft file'
    agents.st-design -> skills.st-design '(43) document id'
    skills.st-design -> user '(44) design is open in the design tool, say when it looks good'
    user -> skills.st-design '(45) change request or looks good'
    skills.st-design -> agents.st-design '(46) step change: request and document id'
    skills.st-design -> agents.st-design '(47) step save: document id'
    agents.st-design -> project.design '(48) saved design and its read export'
    agents.st-design -> skills.st-design '(49) saved design path and token files written'
    skills.st-design -> skills.st-impeccable '(50) document in scan mode, file shown at the gate'
    skills.st-design -> agents.st-design '(51) step build: screen name'
    agents.st-design -> project.design '(52) saved design layout, picture and variables'
    agents.st-design -> skills.st-design '(53) report: files, screenshots, lint and render results'
    skills.st-design -> skills.st-impeccable '(54) audit and critique, at most 2 fix rounds'
    skills.st-design -> user '(55) screenshots, theme pick, report and DESIGN.md'
    user -> skills.st-design '(56) gate: yes, commit the screen and the saved design'
    skills.st-design -> agents.st-git '(57) agent paths, DESIGN.md and the saved design'
    agents.st-git -> git '(58) commit'
  }
}
