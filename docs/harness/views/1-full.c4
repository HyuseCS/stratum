views {
  dynamic view full {
    title 'Full lane'
    user -> skills.st '(1) task in plain words'
    skills.st -> user '(2) lane and risk line'
    skills.st -> scripts.st-state-sh '(3) risk level'
    scripts.st-state-sh -> stratum.state-json '(4) risk level'
    skills.st -> skills.st-define '(5) feature description'
    skills.st-define -> skills.st-grill '(6) feature description'
    skills.st-grill -> user '(7) one question at a time with a recommended answer'
    user -> skills.st-grill '(8) answers on scope, users, data, privacy and done-criteria'
    skills.st-define -> procedures.specify-md '(9) description and grilling summary'
    procedures.specify-md -> feature.spec-md '(10) spec from the spec template'
    procedures.specify-md -> feature.checklists '(11) requirements checklist'
    procedures.specify-md -> scripts.st-state-sh '(12) feature dir and phase define'
    skills.st-define -> procedures.clarify-md '(13) spec with open markers, only if gaps remain'
    procedures.clarify-md -> feature.spec-md '(14) clarified spec'
    skills.st-define -> procedures.checklist-md '(15) highest impact areas'
    procedures.checklist-md -> feature.checklists '(16) impact-area checklist'
    skills.st-define -> user '(17) gate: you agree the spec'
    skills.st-define -> agents.st-git '(18) spec file paths'
    agents.st-git -> git '(19) spec commit'
    skills.st -> skills.st-plan '(20) feature dir'
    skills.st-plan -> agents.st-plan '(21) plugin root, project root, feature dir'
    agents.st-plan -> procedures.plan-md '(22) plan steps to follow'
    procedures.plan-md -> feature.plan-md '(23) plan'
    procedures.plan-md -> feature.research-md '(24) research decisions'
    procedures.plan-md -> feature.data-model-md '(25) entities'
    procedures.plan-md -> feature.contracts '(26) interface contracts'
    procedures.plan-md -> feature.quickstart-md '(27) validation guide'
    agents.st-plan -> procedures.tasks-md '(28) task steps to follow'
    procedures.tasks-md -> feature.tasks-md '(29) tasks with test commands'
    agents.st-plan -> skills.st-plan '(30) plan report and open decisions'
    skills.st-plan -> user '(31) gate: you answer each open decision'
    skills.st-plan -> agents.st-plan '(32) answers, same agent'
    skills.st-plan -> scripts.st-advisor-sh '(33) plan point and feature dir'
    scripts.st-advisor-sh -> codex '(34) spec, plan and tasks, read-only'
    codex -> scripts.st-advisor-sh '(35) verdict and findings'
    scripts.st-advisor-sh -> feature.advisor-md '(36) plan point record'
    skills.st-plan -> agents.st-git '(37) plan file paths and advisor.md'
    agents.st-git -> git '(38) plan commit'
    skills.st -> skills.st-inspect '(39) feature dir'
    skills.st-inspect -> agents.st-inspect '(40) plugin root, project root, feature dir'
    agents.st-inspect -> procedures.analyze-md '(41) analysis steps to follow'
    agents.st-inspect -> feature.plan-md '(42) Validate section'
    agents.st-inspect -> skills.st-inspect '(43) findings and verdict'
    skills.st-inspect -> scripts.st-advisor-sh '(44) check plan, stale or approved'
    skills.st-inspect -> user '(45) gate: OK to build'
    skills.st -> skills.st-build '(46) feature dir'
    skills.st-build -> agents.st-test '(47) test task ids and absolute paths'
    agents.st-test -> skills.st-build '(48) failing test output'
    skills.st-build -> agents.st-build '(49) build task ids and absolute paths'
    agents.st-build -> feature.tasks-md '(50) ticked task'
    skills.st-build -> scripts.st-verify-sh '(51) test command and touched files'
    scripts.st-verify-sh -> skills.st-build '(52) one PASS or FAIL line'
    skills.st-build -> scripts.st-advisor-sh '(53) test point after 2 red tries, task and both failures'
    skills.st-build -> agents.st-debug '(54) task, test, both failures and advisor answer'
    skills.st-build -> agents.st-git '(55) task paths, tasks.md and advisor.md'
    agents.st-git -> git '(56) task commit'
    skills.st-build -> skills.st-design '(57) screen task and its mode'
    skills.st-build -> agents.st-review '(58) story diff'
    agents.st-review -> skills.st-build '(59) review findings'
    skills.st-build -> scripts.st-advisor-sh '(60) decisions point and small-decision list'
    skills.st-build -> skills.st-impeccable '(61) changed screens not done by the Design lane'
    skills.st-build -> scripts.st-advisor-sh '(62) diff point after the last review'
    skills.st -> skills.st-close '(63) feature dir'
    skills.st-close -> agents.st-close '(64) feature dir, gap report choice, shortcut base'
    agents.st-close -> feature.spec-md '(65) drift fixes'
    agents.st-close -> procedures.converge-md '(66) gap steps 1 to 6, only when asked'
    agents.st-close -> stratum.lessons-md '(67) proposed lessons'
    agents.st-close -> scripts.st-shortcuts-sh '(68) shortcut base'
    agents.st-close -> skills.st-close '(69) drift fixes, gaps, lessons and shortcut rows'
    skills.st-close -> user '(70) send back, defer or drop each gap'
    skills.st-close -> user '(71) keep, retarget or drop each lesson'
    skills.st-close -> user '(72) fix now or keep each shortcut'
    skills.st-close -> skills.st-graphify '(73) docs graph update'
    skills.st-close -> agents.st-git '(74) changed doc paths'
    agents.st-git -> git '(75) close commit'
    skills.st-close -> scripts.st-state-sh '(76) phase done'
    skills.st-close -> user '(77) gate: push'
  }
}
