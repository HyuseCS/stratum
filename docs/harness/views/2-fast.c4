views {
  dynamic view fast {
    title 'Fast lane'
    user -> skills.st-fast '(1) change in plain words'
    skills.st-fast -> agents.st-fast '(2) plugin root, project root, feature dir, change'
    agents.st-fast -> feature.changes '(3) change plan NNN-name.md'
    agents.st-fast -> skills.st-fast '(4) change plan path or move up to Full lane'
    skills.st-fast -> scripts.st-advisor-sh '(5) change point, feature dir, change file'
    scripts.st-advisor-sh -> codex '(6) change plan to review'
    scripts.st-advisor-sh -> feature.advisor-md '(7) change verdict record'
    scripts.st-advisor-sh -> skills.st-fast '(8) advisor verdict'
    skills.st-fast -> user '(9) gate: OK on the change plan'
    skills.st-fast -> agents.st-test '(10) test from the change plan'
    agents.st-test -> skills.st-fast '(11) failing test'
    skills.st-fast -> agents.st-build '(12) test to make pass'
    agents.st-build -> skills.st-fast '(13) green test or 2 failed tries'
    skills.st-fast -> advisor '(14) test red after 2 tries: root cause or rabbit hole'
    skills.st-fast -> agents.st-debug '(15) red test, failures, advisor answer'
    skills.st-fast -> scripts.st-verify-sh '(16) test command and files touched'
    skills.st-fast -> advisor '(17) diff: hidden regressions'
    skills.st-fast -> advisor '(18) small-decision list'
    skills.st-fast -> agents.st-review '(19) change plan path and uncommitted diff'
    agents.st-review -> skills.st-fast '(20) findings'
    skills.st-fast -> agents.st-build '(21) real small findings'
    skills.st-fast -> agents.st-git '(22) exact paths of the change'
    agents.st-git -> git '(23) change commit'
    skills.st-fast -> agents.st-close '(24) base commit from step 1'
    agents.st-close -> skills.st-fast '(25) drift list, shortcut rows, proposed lesson'
    skills.st-fast -> user '(26) shortcut rows to fix now or keep, small decisions and findings'
    skills.st-fast -> agents.st-git '(27) docs st-close changed, kept lesson files, gitignore'
    agents.st-git -> git '(28) docs commit'
    skills.st-fast -> hooks.st-phase-py '(29) Phase: done line'
    hooks.st-phase-py -> stratum.state-json '(30) phase done'
  }
}
